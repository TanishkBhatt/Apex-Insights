# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon PostgreSQL connection string (use the pooled -pooler endpoint for the app).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Strong random secret for Better Auth. Generate locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="replace-with-32-byte-random-string"

# Local dev origin. In Vercel production set this to the deployed HTTPS origin,
# e.g. https://your-project.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# Google Gemini API key for the optional AI demo-data and survey generators.
# Create one in Google AI Studio. Keep this server-side only; never prefix it
# with NEXT_PUBLIC_ or commit it.
GEMINI_API_KEY=""

# Optional Gemini model override. Use a model available to your API key.
GEMINI_MODEL="gemini-3.6-flash"
